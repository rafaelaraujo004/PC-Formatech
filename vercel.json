{
  "version": 2,
  "crons": [
    {
      "path": "/api/resumo-diario",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/send-notifications",
      "schedule": "0 10 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=(), usb=(), browsing-topics=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.googleapis.com https://www.gstatic.com; frame-src 'self' https://*.firebaseapp.com; worker-src 'self'; manifest-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*).(png|jpg|jpeg|svg|webp|avif|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/themes/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/apps",
      "destination": "/apps.html",
      "permanent": true
    },
    {
      "source": "/loja",
      "destination": "/loja.html",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "pcformatech.vercel.app"
        }
      ],
      "destination": "https://www.pcformatech.com.br/",
      "permanent": true
    },
    {
      "source": "/site.html",
      "has": [
        {
          "type": "host",
          "value": "pcformatech.vercel.app"
        }
      ],
      "destination": "https://www.pcformatech.com.br/site.html",
      "permanent": true
    },
    {
      "source": "/loja.html",
      "has": [
        {
          "type": "host",
          "value": "pcformatech.vercel.app"
        }
      ],
      "destination": "https://www.pcformatech.com.br/loja.html",
      "permanent": true
    },
    {
      "source": "/formulario-formatacao.html",
      "has": [
        {
          "type": "host",
          "value": "pcformatech.vercel.app"
        }
      ],
      "destination": "https://www.pcformatech.com.br/formulario-formatacao.html",
      "permanent": true
    },
    {
      "source": "/servicos/:caminho(.*)",
      "has": [
        {
          "type": "host",
          "value": "pcformatech.vercel.app"
        }
      ],
      "destination": "https://www.pcformatech.com.br/servicos/:caminho",
      "permanent": true
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "pcformatech.vercel.app"
        }
      ],
      "destination": "https://www.pcformatech.com.br/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "pcformatech.vercel.app"
        }
      ],
      "destination": "https://www.pcformatech.com.br/robots.txt",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/a/imagem/:codigo",
      "destination": "/api/arte?img=:codigo"
    },
    {
      "source": "/a/story/:codigo",
      "destination": "/api/arte?story=:codigo"
    },
    {
      "source": "/a/:slug",
      "destination": "/api/arte?s=:slug"
    }
  ]
}
