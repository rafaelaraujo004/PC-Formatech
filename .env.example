# Firebase Configuration
# Copie este arquivo para .env.local e preencha com suas credenciais
# Obtenha em: https://console.firebase.google.com/project/pc-formatech/settings/general

VITE_FIREBASE_API_KEY=sua_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ===== Atendimento WhatsApp Business (Cloud API da Meta) =====
# Configure estas variáveis no painel da Vercel (Settings → Environment
# Variables), NUNCA no código. Veja o passo a passo em WHATSAPP-BUSINESS.md.

# Token de acesso do app (Meta → WhatsApp → API Setup). Comece com o temporário
# e depois troque por um permanente (token de usuário do sistema).
WHATSAPP_TOKEN=

# Id do número comercial na Cloud API (Meta → WhatsApp → API Setup → "Phone number ID").
WHATSAPP_PHONE_NUMBER_ID=

# Texto que VOCÊ inventa; usado só na verificação do webhook. Repita o mesmo
# valor no campo "Verify token" da Meta ao configurar o webhook.
WHATSAPP_VERIFY_TOKEN=

# "App Secret" do app Meta (Configurações do app → Básico). Confere a
# assinatura de cada chamada do webhook.
WHATSAPP_APP_SECRET=

# Opcional: versão da Graph API (padrão v21.0).
WHATSAPP_API_VERSION=v21.0
