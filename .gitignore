# ===== ARQUIVOS SENSÍVEIS - NÃO COMMITAR =====
# Variáveis de ambiente
.env
.env.local
.env.production
.env.development
.env.*.local

# Configuração do Firebase - NOTA: firebase-config.js PODE ser commitado
# As API Keys do Firebase são públicas e seguras quando protegidas por regras do Firestore
# firebase-config.example.js (este pode ficar ignorado)

# ===== NODE MODULES =====
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# ===== BUILD E DISTRIBUIÇÃO =====
dist/
build/
.vercel/
.output/
*.min.js
*.min.css

# ===== LOGS =====
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== SISTEMA OPERACIONAL =====
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ===== IDEs =====
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ===== TEMPORÁRIOS =====
*.tmp
*.temp
~$*
*.backup
*.bak

# ===== CACHE =====
.cache/
.parcel-cache/
.next/
.nuxt/

# Proteção extra: nunca envie dados sensíveis ou exportações de dados
# NOTA: *.json removido pois bloqueava manifest.json, vercel.json etc.
clientes*.json
produtos*.json
orcamentos*.json
budgets*.json
firebase-export*
*.bak
*.backup
*.sqlite
*.db

# ===== ARQUIVOS DO FIREBASE =====
# firebase-config.js NÃO é mais bloqueado - chaves Firebase são públicas por design
# A segurança é garantida pelas regras do Firestore, não pelo sigilo das chaves
# Veja: https://firebase.google.com/docs/projects/api-keys
firebase-config.example.js

